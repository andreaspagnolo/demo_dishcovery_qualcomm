# Large external model assets stay outside Git. SigLIP/reranker hashes are
# versioned in config/checksums; custom Qwen checksums accompany its archive.
external_assets/models/*
!external_assets/models/.gitkeep
external_assets/images/
external_assets/wheels/
third_party/
model_build/qwen3_vl_reranker/build/
demo_runs/
run_outputs/
.venv*/
__pycache__/
*.py[cod]
config/google_drive.env

# Additional custom Qwen distribution files.
Qwen3-VL-4B-Instruct-GenieX-QAIRT-W8A16.zip
Qwen3-VL-4B-Instruct-GenieX-QAIRT-W8A16.zip.sha256
